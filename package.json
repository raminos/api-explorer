{
  "name": "api-explorer",
  "version": "0.1.0",
  "description": "Generate composable, type-safe API backends and explorer UIs from a versioned JSON contract.",
  "type": "module",
  "bin": {
    "api-explorer": "./src/cli.ts"
  },
  "scripts": {
    "check": "bun run check:types && bun run check:biome && bun run test",
    "check:biome": "biome check .",
    "check:types": "tsc --noEmit",
    "format": "biome check --write .",
    "generate:example": "bun run src/cli.ts generate examples/jsonplaceholder/api-explorer.json --output .generated/jsonplaceholder",
    "start": "bun run src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect/cli": "0.76.0",
    "@effect/platform": "0.97.0",
    "@effect/platform-bun": "0.91.0",
    "effect": "3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@effect/vitest": "0.30.0",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raminos/api-explorer.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
